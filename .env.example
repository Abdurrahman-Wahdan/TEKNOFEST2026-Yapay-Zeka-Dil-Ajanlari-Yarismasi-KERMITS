# Copy to .env and edit. Every key here must exist in config/settings.py
# (tests/unit/test_settings.py enforces that).

# ===== LLM (local vLLM) =====
VLLM_BASE_URL=https://unbundle-semisoft-mouth.ngrok-free.dev
VLLM_API_KEY=EMPTY
LLM_TIMEOUT=300
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.0

# Role -> model key (gemma | qwen | gpt)
DEFAULT_MODEL=qwen
CHAT_MODEL=gemma
EXTRACTOR_MODEL=qwen
REASONER_MODEL=gpt

# ===== Embeddings =====
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16

# ===== Vector store (local Qdrant) =====
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT=30
QDRANT_COLLECTION_CAMPAIGNS=campaigns

# ===== Application =====
LOG_LEVEL=INFO
ENVIRONMENT=development
