{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec \"$HOME/.pyenv/versions/tf26/bin/python\" -m uvicorn api.main:app --reload --reload-exclude '.claude/*' --reload-exclude 'UI/*' --host 127.0.0.1 --port 8210"
      ],
      "port": 8210,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "API_ORIGIN=http://127.0.0.1:8210 exec npm run dev -- --port 3210"
      ],
      "cwd": "UI",
      "port": 3210,
      "autoPort": true
    },
    {
      "name": "vision-ui",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "BROWSER=none PORT=3211 npm start"
      ],
      "cwd": "reference/vision-ui-dashboard-react",
      "port": 3211
    }
  ]
}
