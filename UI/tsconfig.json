{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "components/*": [
        "./src/vision/components/*"
      ],
      "examples/*": [
        "./src/vision/examples/*"
      ],
      "layouts/*": [
        "./src/vision/layouts/*"
      ],
      "assets/*": [
        "./src/vision/assets/*"
      ],
      "variables/*": [
        "./src/vision/variables/*"
      ],
      "context/*": [
        "./src/vision/context/*"
      ],
      "context": [
        "./src/vision/context"
      ],
      "routes": [
        "./src/vision/routes"
      ],
      "vision/*": [
        "./src/vision/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
